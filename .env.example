# Ambiente: dev, homolog, prod ou pytest (pytest desliga as validações obrigatórias)
SATURDAY_ENVIRONMENT=dev
# Nível de log: DEBUG, INFO, WARNING, ERROR
SATURDAY_LOG_LEVEL=INFO
# Chave esperada no header X-API-Key (obrigatória em prod)
SATURDAY_API_KEY=
# Chave da API do OpenRouter (obrigatória fora de pytest)
SATURDAY_OPENROUTER_API_KEY=
# Slug do OpenRouter para o modelo de texto que responde dúvidas
SATURDAY_LLM_MODEL=
# Slug do OpenRouter para o modelo que lê PDF e imagem do extrato
SATURDAY_VISION_MODEL=
# Modelo do Jev usado nas decisões (mantenha fixo para a calibração valer)
SATURDAY_JEV_MODEL=typesafe/jev-1.13
# URL do webhook de saída (vazio = responde na própria requisição)
SATURDAY_WEBHOOK_URL=
# Segredo para assinar o webhook com HMAC-SHA256 (obrigatório se a URL existir)
SATURDAY_WEBHOOK_SECRET=
# Domínios permitidos para anexos por URL, separados por vírgula (vazio = só base64)
SATURDAY_ANEXO_DOMINIOS=
# Dias de retenção do extrato da conversa
SATURDAY_RETENCAO_EXTRATO_DIAS=30
# Horas para liberar automaticamente um handoff (0 = desligado)
SATURDAY_HANDOFF_AUTO_RELEASE_HORAS=0

# Postgres: estado das conversas, outbox e travas. Obrigatório fora de pytest.
# Com o profile `postgres` do compose:
SATURDAY_DATABASE_URL=postgresql://saturday:saturday@postgres:5432/saturday

# Storage S3 dos anexos. Endpoint vazio = MinIO do compose (http://minio:9000).
SATURDAY_S3_ENDPOINT=
SATURDAY_S3_BUCKET=saturday
SATURDAY_S3_ACCESS_KEY=
SATURDAY_S3_SECRET_KEY=
SATURDAY_S3_REGIAO=us-east-1

# Outbox: quantas tentativas de entrega, espera inicial e tamanho do lote.
SATURDAY_OUTBOX_MAX_TENTATIVAS=8
SATURDAY_OUTBOX_BACKOFF_BASE_S=2.0
SATURDAY_OUTBOX_LOTE=20

# WhatsApp Cloud API (Meta). Obrigatórias fora de pytest.
# Em dev, aponte a Graph para o simulador: http://meta:8100
SATURDAY_WHATSAPP_TOKEN=
SATURDAY_WHATSAPP_APP_SECRET=
SATURDAY_WHATSAPP_VERIFY_TOKEN=
# phone_number_id ativos, separados por vírgula
SATURDAY_WHATSAPP_NUMEROS=
SATURDAY_WHATSAPP_GRAPH_URL=https://graph.facebook.com/v23.0
SATURDAY_WHATSAPP_LIMITE_MIDIA_MB=50

# Evolution API (WhatsApp Web, não oficial; docs/decisoes/0009). Desligada por
# padrão. Ligada, exige a chave e o token do webhook. As instâncias são criadas
# na tela Canais do painel (docs/decisoes/0010).
# Em dev, aponte para o simulador: http://evolution-sim:8300
SATURDAY_EVOLUTION_ATIVO=false
SATURDAY_EVOLUTION_URL=http://evolution:8080
SATURDAY_EVOLUTION_API_KEY=
SATURDAY_EVOLUTION_WEBHOOK_TOKEN=
SATURDAY_EVOLUTION_WEBHOOK_URL=http://api:8000/webhooks/evolution
# Senha do Postgres próprio da Evolution (profile `evolution` do compose).
EVOLUTION_POSTGRES_SENHA=

# Transcrição de áudio: endpoint compatível com OpenAI (`/audio/transcriptions`).
# Sem chave e modelo, o canal pede o conteúdo por texto.
SATURDAY_TRANSCRICAO_API_KEY=
SATURDAY_TRANSCRICAO_MODELO=
SATURDAY_TRANSCRICAO_BASE_URL=https://api.openai.com/v1

# Fila de eventos: tamanho do lote e tentativas antes de desistir.
SATURDAY_EVENTOS_LOTE=20
SATURDAY_EVENTOS_MAX_TENTATIVAS=8

# Painel da equipe. Segredo longo e aleatório (ex.: `openssl rand -hex 32`);
# obrigatório fora de pytest. Assina o token CSRF da sessão.
SATURDAY_SESSAO_SEGREDO=

# Granatech. ATIVO liga o cliente (exige CHAVE_API e WEBHOOK_TOKEN).
# O webhook /webhooks/granatech fica sempre no ar: sem token responde 503, e em
# homolog/prod o token é obrigatório. Em dev, aponte a BASE_URL para o simulador.
SATURDAY_GRANATECH_BASE_URL=https://api-dev.granatech.com.br
SATURDAY_GRANATECH_CHAVE_API=
SATURDAY_GRANATECH_WEBHOOK_TOKEN=
SATURDAY_GRANATECH_ATIVO=false
SATURDAY_GRANATECH_PROPOSTA_ATIVA=false
# Correção de conta depois de falha de pagamento; corpo pendente com a Granatech.
SATURDAY_GRANATECH_DADOS_BANCARIOS_ATIVO=false
# Domínio dos links curtos da biometria (https://{dominio}/l/{codigo}).
# Obrigatório com a proposta ligada.
SATURDAY_DOMINIO_PUBLICO=
SATURDAY_GRANATECH_TETO_LIBERADO=6999
# Cota: teto do mês, limite do dia e janela de reaproveitamento por CPF.
SATURDAY_GRANATECH_COTA_MENSAL=500
SATURDAY_GRANATECH_COTA_DIARIA=20
SATURDAY_GRANATECH_REAPROVEITAR_DIAS=30
SATURDAY_GRANATECH_TIPO_EMPREGADOR=1

# Tag da imagem saturday-api; no Dokploy, uma por ambiente
# (development, homolog, production) para os stacks não dividirem a mesma imagem.
SATURDAY_IMAGEM_TAG=local
# Só no Dokploy (compose.dokploy.yaml): rede overlay do Postgres do ambiente,
# por exemplo saturday-dev-dados. Local não usa.
SATURDAY_REDE_DADOS=

# Profiles do compose: `postgres,minio` sobe os serviços internos;
# `evolution` sobe a Evolution API com Postgres e Redis próprios.
# Sem eles, SATURDAY_DATABASE_URL e SATURDAY_S3_* precisam apontar para fora.
COMPOSE_PROFILES=
